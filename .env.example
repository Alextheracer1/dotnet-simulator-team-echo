# ==============================================================================
# RabbitMQ Docker Konfiguration (Energy Twin 2026 - Team Echo)
# ==============================================================================

# RabbitMQ Administrator-Zugangsdaten (wird beim ersten Start des Containers gesetzt)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=/

# Externe Ports für Docker-Host-Mapping
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ==============================================================================
# .NET Simulatoren & Gateway Umgebungsvariablen
# ==============================================================================

# RabbitMQ Verbindungsdaten für lokale Applikationen
RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Simulations-Master Zeitsynchronisation (Standard: 127.0.0.1:1510)
SIMULATION_MASTER_HOST=127.0.0.1
SIMULATION_MASTER_PORT=1510

# Weather-Simulator Minimal API Endpunkt (Standard: http://localhost:5005)
WEATHER_SIMULATOR_URL=http://localhost:5005

# Polling-Intervall des Modbus-RabbitMQ-Gateways in Millisekunden (Standard: 1000)
MODBUS_POLL_INTERVAL_MS=1000
